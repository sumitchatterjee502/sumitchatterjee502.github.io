# URL of your self-hosted contact API (contact-api/server.mjs)
# Local dev: run `npm run dev` in contact-api/, then use:
NEXT_PUBLIC_CONTACT_API_URL=http://localhost:8787

# Production (after Render deploy — see contact-api/README.md):
# NEXT_PUBLIC_CONTACT_API_URL=https://portfolio-contact-api.onrender.com
# Set GitHub Actions secret CONTACT_API_URL to the same value for CI builds.
